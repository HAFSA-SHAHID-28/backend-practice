    <!-- //////     with ejs       /////////// -->
       <img width="300" src="<%= user.image %>" alt="">

       <!-- <%= %> ----   for variable -->

    <ul>
        <li>Name: <%= user.name %></li>
        <li>Email: <%= user.email %></li>
        <li>Contact: <%= user.contact %></li>
        <li>Address: <%= user.address %></li>
   

        <!-- <% %> ----   for js/expression/if/loop etc -->

<!-- conditional rendering  -->

<% if ( user.experience > 2) { %>
   <li>Senior</li>
<% } else {  %>
    <li>Junior</li>
<%  } %>
</ul>



<!-- array print -->


<h3>Skills</h3>

<ul>
    <% user.skills.forEach(skill => {%>
<li><%= skill %></li>
 <% });%>
</ul>

<h3></h3>

</body>
</html>